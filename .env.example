# Copy to .env.local for `next dev`, and to .dev.vars for `npm run preview` (Cloudflare runtime).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon (console.neon.tech > your project > Connect). Server only, never prefix with NEXT_PUBLIC_.
# Pooled connection string (host contains -pooler): used by the app
DATABASE_URL=
# Direct connection string (pooling off): used by db:migrate, db:seed and create-admin
DATABASE_URL_DIRECT=
# Signs session cookies. Any long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# PayPal SANDBOX (test money only). developer.paypal.com > Apps & Credentials > Sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Resend (transactional email). Leave empty to send nothing.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. S.K.I.F.-USA Shop <shop@skifusa-shop.com>
EMAIL_FROM=
# Where customers' replies go (optional)
EMAIL_REPLY_TO=
# Who gets the "new order / cancel request / member request" alerts (comma separated)
ADMIN_NOTIFY_EMAIL=

# Contact form spam protection: Cloudflare Turnstile (free CAPTCHA). Optional but recommended.
# Cloudflare dashboard > Turnstile > Add widget. Leave empty to rely on the built-in protections only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret used to sign the form timestamp (any long random text). Falls back to BETTER_AUTH_SECRET.
CONTACT_SECRET=
